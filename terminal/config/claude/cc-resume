#!/usr/bin/env sh

set -u

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/cc-resume"
PENDING="$STATE_DIR/pending"
LOG="$STATE_DIR/log.jsonl"
LOCK="$STATE_DIR/watch.lock"

POLL="${CC_RESUME_POLL:-60}"
BUFFER="${CC_RESUME_BUFFER:-120}"
BACKOFF="${CC_RESUME_BACKOFF:-1200}"
MAX_ATTEMPTS="${CC_RESUME_MAX_ATTEMPTS:-3}"
MAX_AGE="${CC_RESUME_MAX_AGE:-86400}"
DEFAULT_TEXT="${CC_RESUME_TEXT:-continue}"
DIALOG_MARKER="${CC_RESUME_DIALOG_MARKER:-What do you want to do?}"
DIALOG_SETTLE="${CC_RESUME_DIALOG_SETTLE:-1}"

LAST_ACTION=

usage() {
  cat >&2 <<'EOF'
Usage: cc-resume <command>

  watch              Wait for rate-limited sessions and type the resume text into
                     their herdr pane once the limit clears.
  status             Show pending sessions and when each will be resumed.
  fire <session>     Resume one pending session now, ignoring its timer.
  clear [session]    Drop one pending session, or all of them.

Per-project resume text: put one line in <repo>/.claude/on-resume.
Defaults to "continue"; override globally with CC_RESUME_TEXT.
Set CC_RESUME_DRY_RUN=1 to print what would be typed without typing it.

If the pane is showing Claude's usage dialog ("What do you want to do?"),
Escape is sent to dismiss it before typing, and the resume is retried later
if the dialog does not clear.
EOF
  exit 2
}

need_jq() {
  command -v jq >/dev/null 2>&1 || {
    printf 'cc-resume needs jq on PATH.\n' >&2
    exit 1
  }
}

now() { date +%s; }

log_event() {
  mkdir -p "$STATE_DIR" 2>/dev/null || return 0
  jq -cn --arg at "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$@" '$ARGS.named' >>"$LOG" 2>/dev/null || true
}

markers() {
  [ -d "$PENDING" ] || return 0
  for m in "$PENDING"/*.json; do
    [ -e "$m" ] || continue
    printf '%s\n' "$m"
  done
}

field() {
  jq -r --arg k "$2" '.[$k] // empty' "$1" 2>/dev/null
}

target_at() {
  jq -r --argjson buffer "$BUFFER" --argjson backoff "$BACKOFF" '
    (.attempts // 0) as $attempts |
    if (.resets_at | type) == "number" and $attempts == 0
    then (.resets_at + $buffer)
    else ((.stopped_at // 0) + $backoff * ($attempts + 1))
    end | floor' "$1" 2>/dev/null
}

resume_text() {
  file="$1/.claude/on-resume"
  if [ -f "$file" ]; then
    text=$(sed -n '1p' "$file" | sed 's/[[:space:]]*$//')
    [ -n "$text" ] && {
      printf '%s' "$text"
      return 0
    }
  fi
  printf '%s' "$DEFAULT_TEXT"
}

pane_has_agent() {
  herdr agent list 2>/dev/null |
    jq -e --arg p "$1" '.result.agents[]? | select(.pane_id == $p)' >/dev/null 2>&1
}

pane_shows_dialog() {
  screen=$(herdr pane read "$1" --source visible 2>/dev/null) || return 1
  case "$screen" in
    *"$DIALOG_MARKER"*) return 0 ;;
  esac
  return 1
}

fail_attempt() {
  marker=$1
  reason=$2
  session=$3
  pane=$4
  prior=$5

  bump_attempts "$marker"
  if [ "$((prior + 1))" -ge "$MAX_ATTEMPTS" ]; then
    log_event --arg event gave_up --arg reason "$reason" --arg session "$session" \
      --arg pane "$pane" --argjson attempts "$((prior + 1))"
    rm -f "$marker"
  else
    log_event --arg event retry --arg reason "$reason" --arg session "$session" \
      --arg pane "$pane" --argjson attempts "$((prior + 1))"
  fi
  LAST_ACTION=retry
}

bump_attempts() {
  tmp="$1.$$"
  if jq '.attempts = ((.attempts // 0) + 1)' "$1" >"$tmp" 2>/dev/null; then
    mv -f "$tmp" "$1" 2>/dev/null || rm -f "$tmp"
  else
    rm -f "$tmp"
  fi
}

fire_marker() {
  marker="$1"
  LAST_ACTION=
  session=$(field "$marker" session_id)
  pane=$(field "$marker" pane_id)
  cwd=$(field "$marker" cwd)
  err=$(field "$marker" error)
  attempts=$(jq -r '.attempts // 0' "$marker" 2>/dev/null)

  if [ -z "$pane" ]; then
    log_event --arg event dropped --arg reason no_pane_id --arg session "$session"
    rm -f "$marker"
    return 0
  fi

  if ! command -v herdr >/dev/null 2>&1; then
    log_event --arg event skipped --arg reason herdr_missing --arg session "$session"
    return 0
  fi

  if ! pane_has_agent "$pane"; then
    log_event --arg event dropped --arg reason pane_gone \
      --arg session "$session" --arg pane "$pane"
    rm -f "$marker"
    return 0
  fi

  text=$(resume_text "$cwd")

  if [ "${CC_RESUME_DRY_RUN:-0}" != "0" ]; then
    if pane_shows_dialog "$pane"; then
      printf 'cc-resume: %s shows the usage dialog; would send Escape, then type "%s" (%s)\n' \
        "$pane" "$text" "$cwd"
    else
      printf 'cc-resume: would type "%s" into %s (%s)\n' "$text" "$pane" "$cwd"
    fi
    return 0
  fi

  if pane_shows_dialog "$pane"; then
    log_event --arg event dialog_seen --arg session "$session" --arg pane "$pane"
    herdr pane send-keys "$pane" Escape >/dev/null 2>&1
    sleep "$DIALOG_SETTLE"
    if pane_shows_dialog "$pane"; then
      fail_attempt "$marker" dialog_stuck "$session" "$pane" "$attempts"
      return 0
    fi
  fi

  if herdr pane run "$pane" "$text" >/dev/null 2>&1; then
    log_event --arg event resumed --arg session "$session" --arg pane "$pane" \
      --arg cwd "$cwd" --arg error "$err" --arg text "$text"
    printf 'cc-resume: typed "%s" into %s (%s)\n' "$text" "$pane" "$cwd"
    rm -f "$marker"
    LAST_ACTION=typed
    return 0
  fi

  fail_attempt "$marker" send_failed "$session" "$pane" "$attempts"
}

sweep() {
  t=$(now)
  list="$STATE_DIR/.sweep.$$"
  markers >"$list" 2>/dev/null || return 0
  fired=' '

  while IFS= read -r marker; do
    [ -f "$marker" ] || continue

    stopped=$(jq -r '.stopped_at // 0' "$marker" 2>/dev/null)
    case "$stopped" in
      '' | *[!0-9]*) stopped=0 ;;
    esac
    if [ "$stopped" -gt 0 ] && [ "$((t - stopped))" -gt "$MAX_AGE" ]; then
      log_event --arg event dropped --arg reason stale \
        --arg session "$(field "$marker" session_id)"
      rm -f "$marker"
      continue
    fi

    target=$(target_at "$marker")
    case "$target" in
      '' | *[!0-9]*) target=0 ;;
    esac
    [ "$t" -ge "$target" ] || continue

    pane=$(field "$marker" pane_id)
    if [ -n "$pane" ]; then
      case "$fired" in
        *" $pane "*)
          log_event --arg event coalesced --arg pane "$pane" \
            --arg session "$(field "$marker" session_id)"
          rm -f "$marker"
          continue
          ;;
      esac
    fi

    fire_marker "$marker"
    if [ "$LAST_ACTION" = typed ] && [ -n "$pane" ]; then
      fired="$fired$pane "
    fi
  done <"$list"

  rm -f "$list"
}

acquire_lock() {
  mkdir -p "$STATE_DIR" 2>/dev/null || true
  if mkdir "$LOCK" 2>/dev/null; then
    printf '%s\n' "$$" >"$LOCK/pid"
    return 0
  fi

  holder=$(cat "$LOCK/pid" 2>/dev/null)
  case "$holder" in
    '' | *[!0-9]*) ;;
    *)
      if kill -0 "$holder" 2>/dev/null; then
        printf 'cc-resume: a watcher is already running (pid %s)\n' "$holder" >&2
        return 1
      fi
      ;;
  esac

  rm -f "$LOCK/pid"
  rmdir "$LOCK" 2>/dev/null || return 1
  mkdir "$LOCK" 2>/dev/null || return 1
  printf '%s\n' "$$" >"$LOCK/pid"
  log_event --arg event stale_lock_cleared --arg holder "${holder:-unknown}"
  return 0
}

release_lock() {
  rm -f "$LOCK/pid"
  rmdir "$LOCK" 2>/dev/null || true
}

cmd_watch() {
  mkdir -p "$PENDING" 2>/dev/null || true
  acquire_lock || exit 1
  trap 'kill "${SLEEP_PID:-0}" 2>/dev/null; release_lock; exit 0' INT TERM HUP
  trap 'release_lock' EXIT

  log_event --arg event watch_started --argjson poll "$POLL" --argjson pid "$$"
  printf 'cc-resume: watching %s (poll %ss, pid %s)\n' "$PENDING" "$POLL" "$$"
  while :; do
    sweep
    sleep "$POLL" &
    SLEEP_PID=$!
    wait "$SLEEP_PID" 2>/dev/null || :
  done
}

cmd_status() {
  if [ "$(markers | wc -l | tr -d ' ')" -eq 0 ]; then
    printf 'cc-resume: nothing pending\n'
    return 0
  fi
  t=$(now)
  markers | while IFS= read -r marker; do
    session=$(field "$marker" session_id)
    pane=$(field "$marker" pane_id)
    cwd=$(field "$marker" cwd)
    err=$(field "$marker" error)
    target=$(target_at "$marker")
    case "$target" in
      '' | *[!0-9]*) target=0 ;;
    esac
    if [ "$t" -ge "$target" ]; then
      when='due now'
    else
      when="in $(((target - t) / 60))m"
    fi
    printf '%s  %s  pane=%s  %s  %s\n' "$err" "$when" "${pane:-none}" "$cwd" "$session"
  done
}

last_outcome() {
  [ -f "$LOG" ] || return 1
  entry=$(jq -rc --arg s "$1" 'select(.session? == $s)
    | [(.at // "?"), (.event // "?"), (.pane // ""), (.reason // ""), (.attempts // "")]
    | @tsv' "$LOG" 2>/dev/null | tail -n 1)
  [ -n "$entry" ] || return 1
  printf '%s' "$entry"
}

explain_missing() {
  entry=$(last_outcome "$1") || return 1
  at=$(printf '%s' "$entry" | cut -f1)
  event=$(printf '%s' "$entry" | cut -f2)
  pane=$(printf '%s' "$entry" | cut -f3)
  reason=$(printf '%s' "$entry" | cut -f4)
  attempts=$(printf '%s' "$entry" | cut -f5)

  case "$event" in
    resumed)
      printf 'cc-resume: it was resumed at %s into pane %s; the marker was consumed then\n' \
        "$at" "${pane:-unknown}" >&2
      ;;
    gave_up)
      printf 'cc-resume: it was abandoned at %s after %s attempts (%s)\n' \
        "$at" "${attempts:-?}" "${reason:-unknown}" >&2
      ;;
    dropped)
      printf 'cc-resume: its marker was dropped at %s (%s)\n' "$at" "${reason:-unknown}" >&2
      ;;
    coalesced)
      printf 'cc-resume: it was coalesced at %s into another resume for pane %s\n' \
        "$at" "${pane:-unknown}" >&2
      ;;
    *)
      printf 'cc-resume: last seen at %s (%s)\n' "$at" "$event" >&2
      ;;
  esac

  if [ -n "$pane" ]; then
    printf 'cc-resume: to knock on that pane again by hand: herdr pane run %s continue\n' \
      "$pane" >&2
  fi
  return 0
}

cmd_fire() {
  [ "$#" -eq 1 ] || usage
  safe=$(printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '_')
  marker="$PENDING/$safe.json"
  if [ ! -f "$marker" ]; then
    printf 'cc-resume: no pending session "%s"\n' "$1" >&2
    if ! explain_missing "$1"; then
      if [ "$(markers | wc -l | tr -d ' ')" -eq 0 ]; then
        printf 'cc-resume: nothing is pending\n' >&2
      else
        printf 'cc-resume: pending sessions are:\n' >&2
        markers | while IFS= read -r m; do
          printf '  %s\n' "$(field "$m" session_id)" >&2
        done
      fi
    fi
    exit 1
  fi
  fire_marker "$marker"
}

cmd_clear() {
  if [ "$#" -eq 1 ]; then
    safe=$(printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '_')
    rm -f "$PENDING/$safe.json"
    printf 'cc-resume: cleared %s\n' "$1"
  else
    markers | while IFS= read -r marker; do rm -f "$marker"; done
    printf 'cc-resume: cleared all pending sessions\n'
  fi
}

need_jq
[ "$#" -ge 1 ] || usage
command=$1
shift

case "$command" in
  watch) cmd_watch "$@" ;;
  status) cmd_status "$@" ;;
  fire) cmd_fire "$@" ;;
  clear) cmd_clear "$@" ;;
  *) usage ;;
esac
